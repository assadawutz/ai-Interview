# Server-only key. Obtain from https://aistudio.google.com/apikey
GEMINI_API_KEY=
PORT=3000
HOST=0.0.0.0
# Set the public HTTPS origin when running behind a reverse proxy.
APP_URL=
# Protect the API before sharing the server. Enter this token in System in the UI.
APP_ACCESS_TOKEN=
# Model availability depends on your Google account. Override as needed.
GEMINI_MODEL_FAST=gemini-3.1-flash-lite
GEMINI_MODEL_BALANCED=gemini-3.8-flash
GEMINI_MODEL_DEEP=gemini-4-argon
GEMINI_MODEL_FALLBACK=gemini-3.8-flash
GEMINI_MODEL_TRANSCRIPTION=gemini-3.5-transcribe
GEMINI_MODEL_TTS=gemini-3.8-flash-tts
AI_TIMEOUT_MS=60000
API_RATE_LIMIT=60
AI_MAX_OUTPUT_TOKENS=4096
# Optional per-model text pricing in USD per million tokens. Leave {} to hide estimates.
# Enter current provider rates, e.g. {"your-model-id":{"input":NUMBER,"output":NUMBER}}
# Estimates exclude search, audio, document and other provider charges.
AI_MODEL_PRICING_JSON={}

# AI consistency review is on by default in the UI (one additional bounded model call).
# Optional live evaluation script origin; not used by the application itself.
EVAL_BASE_URL=http://127.0.0.1:3000

# Ollama is reached by this Express server, not by the remote user's browser.
# Keep Ollama local; this value is server-only and cannot be supplied by HTTP headers.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# For slow local CPU models, consider AI_TIMEOUT_MS=180000.
