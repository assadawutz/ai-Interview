{
  "name": "interview-pulse",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "start": "vite preview --host 0.0.0.0",
    "build": "tsc --noEmit -p tsconfig.client.json && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test --config playwright.client.config.ts",
    "check": "npm run format:check && npm run lint && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:client": "playwright test --config playwright.client.config.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.69",
    "@fontsource/noto-sans-thai": "^5.3.0",
    "@google/genai": "^2.30.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ai": "^7.0.141",
    "lucide-react": "^1.57.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
